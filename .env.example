# ---- CDK deploy-time settings (packages/infra) ----
# AWS account / region used by `cdk deploy`
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=ap-northeast-1

# E-mail address that receives the admin role on first sign-in (comma separated for multiple)
COBRAC_ADMIN_EMAILS=you@example.com

# Allow self sign-up (true) or invite only (false). Default: true
COBRAC_SELF_SIGNUP=true

# Max concurrent worker tasks (system-wide) / per user
COBRAC_MAX_CONCURRENT_JOBS=2
COBRAC_MAX_CONCURRENT_JOBS_PER_USER=1

# Codex model used by the worker (leave empty for Codex default)
COBRAC_CODEX_MODEL=
# Reasoning effort: minimal | low | medium | high | xhigh (default: high)
COBRAC_CODEX_REASONING_EFFORT=high

# RCS MCP server used by the agent to anchor UCs on SABRA (defaults: production rcs-mcp and its token secret).
# Uncomment with an empty value to run without RCS.
# COBRAC_RCS_MCP_URL=https://hg2se72l61.execute-api.ap-northeast-1.amazonaws.com/mcp
# COBRAC_RCS_MCP_SECRET_NAME=rcs/mcp-bearer-token

# ---- Frontend build-time settings (packages/web, written by `npm run cdk -- deploy` outputs) ----
# VITE_API_URL=https://xxxx.execute-api.ap-northeast-1.amazonaws.com
# VITE_WS_URL=wss://xxxx.execute-api.ap-northeast-1.amazonaws.com/prod
# VITE_COGNITO_USER_POOL_ID=ap-northeast-1_xxxx
# VITE_COGNITO_CLIENT_ID=xxxx
