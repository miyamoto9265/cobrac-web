{
  "name": "cobrac-web",
  "version": "0.55.0",
  "private": true,
  "description": "CoBRAC Agents - BRA data generation web application powered by Codex SDK",
  "repository": {
    "type": "git",
    "url": "git@github.com:miyamoto9265/cobrac-web.git"
  },
  "workspaces": [
    "packages/shared",
    "packages/api",
    "packages/worker",
    "packages/web",
    "packages/infra"
  ],
  "scripts": {
    "build": "npm run build -w @cobrac/shared && npm run build -w @cobrac/api -w @cobrac/worker -w @cobrac/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test \"scripts/*.test.mjs\"",
    "dev:web": "npm run dev -w @cobrac/web",
    "cdk": "npm run cdk -w @cobrac/infra --",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check",
    "docs:figures": "node scripts/docs-figures.mjs",
    "deploy": "npm run release:check && npm run build && npm run cdk -- deploy --all --require-approval never",
    "docs:prompts": "node scripts/docs-harness-prompts.mjs",
    "docs:prompts:check": "node scripts/docs-harness-prompts.mjs --check",
    "spec:build": "cd docs/spec-guide && ./fetch-fonts.sh && node build.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
