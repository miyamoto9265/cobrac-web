                <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;graph TD\n    %% ROI外の入力（水色系）\n    MGv[\&quot;聴覚視床(MGv/PIN)\&quot;]:::input\n    A1[\&quot;聴覚皮質(A1/Te1)\&quot;]:::input\n    VPL[\&quot;体性感覚視床(VPL/VPM)\&quot;]:::input\n    vHPC[\&quot;腹側海馬(vHPC)\&quot;]:::input\n    LC[\&quot;青斑核(LC)\&quot;]:::input\n    VTA[\&quot;腹側被蓋野(VTA)\&quot;]:::input\n    \n    %% ROI内のUC（黄色系）\n    LA[\&quot;LA&lt;br/&gt;外側扁桃体\&quot;]:::roi\n    BLA[\&quot;BLA&lt;br/&gt;基底外側扁桃体\&quot;]:::roi\n    ITC[\&quot;ITC&lt;br/&gt;介在細胞群\&quot;]:::roi\n    CeA[\&quot;CeA&lt;br/&gt;中心扁桃体\&quot;]:::roi\n    vmPFC[\&quot;vmPFC&lt;br/&gt;腹内側前頭前野\&quot;]:::roi\n    dmPFC[\&quot;dmPFC&lt;br/&gt;背内側前頭前野\&quot;]:::roi\n    \n    %% ROI外の出力（マゼンタ系）\n    PAG[\&quot;中脳水道周囲灰白質(PAG)\&quot;]:::output\n    HYP[\&quot;視床下部(HYP)\&quot;]:::output\n    BNST[\&quot;分界条床核(BNST)\&quot;]:::output\n    \n    %% 感覚入力 → LA\n    MGv --&gt;|条件刺激| LA\n    A1 --&gt;|条件刺激| LA\n    VPL --&gt;|無条件刺激| LA\n    \n    %% LA → BLA\n    LA --&gt;|CS-US連合強度| BLA\n    \n    %% 海馬・修飾系 → BLA\n    vHPC --&gt;|文脈情報| BLA\n    LC --&gt;|記憶固定化| BLA\n    VTA --&gt;|報酬予測誤差| BLA\n    \n    %% BLA → 前頭前野\n    BLA --&gt;|恐怖情動価| vmPFC\n    BLA --&gt;|恐怖情動価| dmPFC\n    \n    %% 前頭前野 → BLA（フィードバック）\n    vmPFC --&gt;|消去記憶-抑制| BLA\n    dmPFC --&gt;|恐怖想起促進| BLA\n    \n    %% 修飾系 → vmPFC\n    LC --&gt;|消去促進| vmPFC\n    \n    %% BLA → ITC\n    BLA --&gt;|恐怖情動価| ITC\n    \n    %% vmPFC → ITC\n    vmPFC --&gt;|安全性評価| ITC\n    \n    %% BLA → CeA\n    BLA --&gt;|恐怖情動価| CeA\n    \n    %% ITC → CeA（抑制）\n    ITC -.-&gt;|抑制信号| CeA\n    \n    %% CeA → 出力\n    CeA --&gt;|防御行動| PAG\n    CeA --&gt;|自律神経反応| HYP\n    CeA --&gt;|持続的不安| BNST\n    \n&quot;,&#10;  &quot;config&quot;: {&#10;    &quot;theme&quot;: &quot;neutral&quot;,&#10;    &quot;arrowMarkerAbsolute&quot;: false,&#10;    &quot;flowchart&quot;: {&#10;      &quot;htmlLabels&quot;: false&#10;    },&#10;    &quot;sequence&quot;: {&#10;      &quot;diagramMarginX&quot;: 50,&#10;      &quot;diagramMarginY&quot;: 10,&#10;      &quot;actorMargin&quot;: 50,&#10;      &quot;width&quot;: 150,&#10;      &quot;height&quot;: 65,&#10;      &quot;boxMargin&quot;: 10,&#10;      &quot;boxTextMargin&quot;: 5,&#10;      &quot;noteMargin&quot;: 10,&#10;      &quot;messageMargin&quot;: 35,&#10;      &quot;mirrorActors&quot;: true,&#10;      &quot;bottomMarginAdj&quot;: 1,&#10;      &quot;useMaxWidth&quot;: true,&#10;      &quot;rightAngles&quot;: false,&#10;      &quot;showSequenceNumbers&quot;: false&#10;    },&#10;    &quot;gantt&quot;: {&#10;      &quot;titleTopMargin&quot;: 25,&#10;      &quot;barHeight&quot;: 20,&#10;      &quot;barGap&quot;: 4,&#10;      &quot;topPadding&quot;: 50,&#10;      &quot;leftPadding&quot;: 75,&#10;      &quot;gridLineStartPadding&quot;: 35,&#10;      &quot;fontSize&quot;: 11,&#10;      &quot;fontFamily&quot;: &quot;\&quot;Open-Sans\&quot;, \&quot;sans-serif\&quot;&quot;,&#10;      &quot;numberSectionStyles&quot;: 4,&#10;      &quot;axisFormat&quot;: &quot;%Y-%m-%d&quot;&#10;    },&#10;    &quot;securityLevel&quot;: &quot;strict&quot;,&#10;    &quot;startOnLoad&quot;: false,&#10;    &quot;themeVariables&quot;: {&#10;      &quot;primaryColor&quot;: &quot;#eee&quot;,&#10;      &quot;contrast&quot;: &quot;#707070&quot;,&#10;      &quot;secondaryColor&quot;: &quot;hsl(0, 0%, 98.9215686275%)&quot;,&#10;      &quot;background&quot;: &quot;#ffffff&quot;,&#10;      &quot;tertiaryColor&quot;: &quot;hsl(-160, 0%, 93.3333333333%)&quot;,&#10;      &quot;primaryBorderColor&quot;: &quot;hsl(0, 0%, 83.3333333333%)&quot;,&#10;      &quot;secondaryBorderColor&quot;: &quot;hsl(0, 0%, 88.9215686275%)&quot;,&#10;      &quot;tertiaryBorderColor&quot;: &quot;hsl(-160, 0%, 83.3333333333%)&quot;,&#10;      &quot;primaryTextColor&quot;: &quot;#111111&quot;,&#10;      &quot;secondaryTextColor&quot;: &quot;rgb(2.7499999999, 2.7499999999, 2.7499999999)&quot;,&#10;      &quot;tertiaryTextColor&quot;: &quot;rgb(17.0000000001, 17.0000000001, 17.0000000001)&quot;,&#